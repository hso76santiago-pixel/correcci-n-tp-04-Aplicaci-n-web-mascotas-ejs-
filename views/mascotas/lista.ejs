<header class="cabecera-pagina">
  <div>
    <p class="etiqueta">CATÁLOGO</p>
    <h1><%= titulo %></h1>
  </div>
  <a class="boton" href="/mascotas/nueva">Agregar mascota</a>
</header>

<% if (mascotas.length === 0) { %>
  <p>No hay mascotas para mostrar.</p>
<% } else { %>
  <section class="grilla" aria-label="Mascotas disponibles">
    <% mascotas.forEach((mascota) => { %>
      <article class="tarjeta">
        <img 
          src="<%= mascota.imagen %>" 
          alt="<%= mascota.nombre %>" 
          class="imagen-mascota"
          onerror="this.onerror=null; this.src='/img/mascota.svg';"
        >
        <p class="etiqueta"><%= mascota.especie %></p>
        <h2><%= mascota.nombre %></h2>
        <p><strong>Edad:</strong> <%= mascota.edad %> <%= Number(mascota.edad) === 1 ? 'año' : 'años' %></p>
        <p><strong>Estado:</strong> <%= mascota.estado %></p>
        <a href="/mascotas/<%= mascota.id %>">Ver detalle</a>
      </article>
    <% }) %>
  </section>
<% } %>